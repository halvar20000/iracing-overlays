# Normalize line endings to stop CRLF/LF churn between Windows and Mac.
# Git stores text files with LF internally and checks them out with the
# platform's native endings, so editing the same file on either machine
# no longer produces noisy whole-file diffs.
* text=auto

# Binary assets: never touch (no line-ending or diff processing).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.tga  binary
*.pdf  binary
*.mp4  binary
*.zip  binary
